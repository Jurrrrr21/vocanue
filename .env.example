# Runtime: Neon pooled connection URL (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# Migrations: Neon direct connection URL, for the same database.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# A random token of at least 32 characters. Match your Vapi Bearer credential.
VAPI_WEBHOOK_TOKEN="replace-with-a-random-token-at-least-32-characters"
